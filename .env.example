# ─── Database ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string pointing to AWS RDS
DB_CONNECTION=Host=seu-endpoint.rds.amazonaws.com;Port=5432;Database=postgres;Username=seu_usuario;Password=sua_senha;SSL Mode=Require

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 64 characters for HS512. Generate with:
#   openssl rand -base64 64
JWT_KEY=CHAVE_MINIMA_64_CARACTERES_PARA_HS512_DEVEM_SER_GERADAS_EM_PRODUCAO

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=clinix-clinical-documents
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_KEY=sk-...
