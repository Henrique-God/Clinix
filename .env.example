# ─── Database ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string pointing to AWS RDS

# (COLOCA EM STRING, CASO CONTRÁRIO, NÃO FUNCIONA)
DB_CONNECTION="Host=seu-endpoint.rds.amazonaws.com;Port=5432;Database=postgres;Username=seu_usuario;Password=sua_senha;SSL Mode=Require"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 64 characters for HS512. Generate with:
#   openssl rand -base64 64
JWT_KEY=CHAVE_MINIMA_64_CARACTERES_PARA_HS512_DEVEM_SER_GERADAS_EM_PRODUCAO
USERS_INTERNAL_API_KEY=users-internal-key-change-me
APPOINTMENTS_INTERNAL_API_KEY=appointments-internal-key-change-me

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=clinix-clinical-documents
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ─── Chatbot Python / OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY="sua-chave-openai-aqui"
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_REQUEST_TIMEOUT_SECONDS=120
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_ENABLED=true
CHAT_MEMORY_POSTGRES_DSN="Host=seu-endpoint.rds.amazonaws.com;Port=5432;Database=postgres;Username=seu_usuario;Password=sua_senha;SSL Mode=Require"
CHAT_MEMORY_SCHEMA=chatbot
CHAT_MEMORY_WINDOW_MESSAGES=12
